# Copy this file to `.env` and replace the placeholder with your real secrets

DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

BETTER_AUTH_SECRET=
# Must match the browser's origin, including https:// and the external port.
BETTER_AUTH_URL=https://secure-file-manager.dev:8443

# console prints email contents and links to server logs; resend delivers to inboxes.
EMAIL_PROVIDER=console
# For Resend, use an authorized sender (your verified domain for real recipients).
EMAIL_FROM="SecureFileManager <onboarding@resend.dev>"
# Required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

FILE_ENCRYPTION_KEK=

# Shared file-operation configuration for web and worker (milliseconds).
FILE_LEASE_MS=60000
FILE_HEARTBEAT_MS=15000
FILE_WORKER_POLL_MS=5000
# Public browser setting is baked into the image; rebuild after changing it.
NEXT_PUBLIC_FILE_OPERATION_POLL_MS=2000
FILE_MAX_ATTEMPTS=3
FILE_RETRY_FIRST_MS=5000
FILE_RETRY_SECOND_MS=30000
FILE_CLEANUP_GRACE_MS=300000
FILE_IO_TIMEOUT_MS=10000
FILE_DATABASE_TIMEOUT_MS=5000
FILE_ATTEMPT_TIMEOUT_MS=120000
# FILE_STORAGE_DIRECTORY=storage
